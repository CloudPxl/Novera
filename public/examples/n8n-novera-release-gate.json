{
  "name": "Novera — pre-release gate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "novera-release-gate",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Release pipeline calls",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        100
      ],
      "id": "release-pipeline-calls",
      "webhookId": "novera-release-gate",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Release gate secret"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "novera_url",
              "type": "string",
              "value": "https://www.nover.space"
            },
            {
              "id": "a1",
              "name": "agent_id",
              "type": "string",
              "value": "REPLACE_WITH_AGENT_ID"
            },
            {
              "id": "a2",
              "name": "suite_id",
              "type": "string",
              "value": "REPLACE_WITH_SUITE_ID"
            },
            {
              "id": "a3",
              "name": "release_id",
              "type": "string",
              "value": "={{ $json.body?.release_id ?? '' }}"
            },
            {
              "id": "a4",
              "name": "knowledge_base_revision",
              "type": "string",
              "value": "={{ $json.body?.knowledge_base_revision ?? '' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Configure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        100
      ],
      "id": "configure"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configure').item.json.novera_url }}/api/v1/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ agent_id: $('Configure').item.json.agent_id, suite_id: $('Configure').item.json.suite_id }, $('Configure').item.json.release_id ? { release_id: $('Configure').item.json.release_id } : {}, $('Configure').item.json.knowledge_base_revision ? { knowledge_base_revision: $('Configure').item.json.knowledge_base_revision } : {})) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "name": "Start run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "id": "start-run",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Novera API key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 201,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Run started?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        100
      ],
      "id": "run-started"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ outcome: 'blocked', release_id: $('Configure').item.json.release_id || null, reason: 'The Novera run could not start: ' + ($json.body?.error ?? 'HTTP ' + $json.statusCode) }) }}",
        "options": {
          "responseCode": 409
        }
      },
      "name": "Respond: could not start",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        320
      ],
      "id": "respond-could-not-start"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configure').item.json.novera_url }}/api/v1/runs/{{ $('Start run').item.json.body.run.id }}/execute",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Advance run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "id": "advance-run",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Novera API key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.done }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "c1",
              "leftValue": "={{ $runIndex }}",
              "rightValue": 90,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        100
      ],
      "id": "finished"
    },
    {
      "parameters": {
        "amount": 10
      },
      "name": "Wait 10 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        320
      ],
      "id": "wait-10-seconds",
      "webhookId": "novera-wait-10s"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configure').item.json.novera_url }}/api/v1/runs/{{ $('Start run').item.json.body.run.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Get result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        100
      ],
      "id": "get-result",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Novera API key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.run.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c1",
              "leftValue": "={{ $json.run.counts.failed }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.run.counts.no_result }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "c3",
              "leftValue": "={{ $json.run.report }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Release may proceed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        100
      ],
      "id": "release-may-proceed"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ outcome: 'pass', release_id: $('Configure').item.json.release_id || null, counts: $json.run.counts, report_url: $json.run.report.url, message: 'Novera: all ' + $json.run.counts.passed + ' scenarios passed. Report: ' + $json.run.report.url }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "name": "Respond: proceed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1540,
        0
      ],
      "id": "respond-proceed"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ outcome: $json.run.status !== 'completed' || !$json.run.report ? 'incomplete' : $json.run.counts.failed > 0 ? 'fail' : 'incomplete', release_id: $('Configure').item.json.release_id || null, counts: $json.run.counts, report_url: $json.run.report ? $json.run.report.url : null, message: 'Novera: ' + $json.run.counts.failed + ' failed, ' + $json.run.counts.no_result + ' with no result, ' + $json.run.counts.passed + ' passed. A scenario with no result is not a pass. ' + ($json.run.report ? 'Report: ' + $json.run.report.url : 'No report was sealed: ' + ($json.run.error || ($json.run.status === 'completed' ? 'no scenario produced a verdict, so there was nothing to seal.' : 'the run did not finish (status: ' + $json.run.status + ').'))) }) }}",
        "options": {
          "responseCode": 409
        }
      },
      "name": "Respond: blocked",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1540,
        200
      ],
      "id": "respond-blocked"
    }
  ],
  "connections": {
    "Release pipeline calls": {
      "main": [
        [
          {
            "node": "Configure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configure": {
      "main": [
        [
          {
            "node": "Start run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start run": {
      "main": [
        [
          {
            "node": "Run started?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run started?": {
      "main": [
        [
          {
            "node": "Advance run",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond: could not start",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Advance run": {
      "main": [
        [
          {
            "node": "Finished?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Finished?": {
      "main": [
        [
          {
            "node": "Get result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 10 seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 10 seconds": {
      "main": [
        [
          {
            "node": "Advance run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get result": {
      "main": [
        [
          {
            "node": "Release may proceed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Release may proceed?": {
      "main": [
        [
          {
            "node": "Respond: proceed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond: blocked",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "novera": "A release pipeline POSTs {release_id, knowledge_base_revision} to this webhook and waits. 200 only when every scenario passed and a report was sealed; 409 otherwise, including when the run could not start or did not finish."
  }
}
