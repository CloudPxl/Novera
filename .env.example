# Novera environment template. Copy to .env.local and fill in.
# NEVER commit a filled-in copy. Real values live only in .env.local and in
# the Vercel dashboard. Nothing in this file may ever hold a real secret.

# --- App ---
# Public base URL of this app. Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# --- Supabase (project must be created in the Frankfurt / eu-central-1 region) ---
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API -> anon/public key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role key. SERVER ONLY. Bypasses RLS.
# Never import this into a client component or log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Secret encryption ---
# 32-byte key, base64. Encrypts customer-supplied model API keys at rest.
# Generate with: openssl rand -base64 32
NOVERA_ENCRYPTION_KEY=

# --- Judge model (hybrid funding) ---
# Free-tier provider key used ONLY for trial runs. Paid workspaces use the
# customer's own key, stored encrypted in the database, never here.
JUDGE_FREE_PROVIDER=
JUDGE_FREE_API_KEY=
JUDGE_FREE_MODEL=

# --- Email (Resend free tier) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
