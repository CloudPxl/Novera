# Novera environment template. Copy to .env.local and fill in.
# NEVER commit a filled-in copy. Real values live only in .env.local and in
# the Vercel dashboard. Nothing in this file may ever hold a real secret.

# --- App ---
# Public base URL of this app. Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# --- Supabase (project must be created in the Frankfurt / eu-central-1 region) ---
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API -> anon/public key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role key. SERVER ONLY. Bypasses RLS.
# Never import this into a client component or log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Secret encryption ---
# 32-byte key, base64. Encrypts customer-supplied model API keys at rest.
# Generate with: openssl rand -base64 32
NOVERA_ENCRYPTION_KEY=

# --- Judge model (hybrid funding) ---
# Free-tier provider key used ONLY for trial runs. Paid workspaces use the
# customer's own key, stored encrypted in the database, never here.
JUDGE_FREE_PROVIDER=
JUDGE_FREE_API_KEY=
JUDGE_FREE_MODEL=

# --- Grading vendors ---
# One key per vendor, named <CONNECTION>_API_KEY. The connection name is what the
# route table in src/lib/router/routes.ts refers to, and adding a host is one line
# there plus one line here.
#
# At least TWO of these must be present and funded, because a verdict is the finding
# of two models from different vendors. Two models from one vendor share a lineage, a
# serving stack and a rate limit; with one vendor configured, every case comes back
# uncorroborated and the report says so. `npm run verify:models` checks this.
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Optional. Not in any route by default — a key that authenticates but has no credits
# would burn a failed attempt on every single call.
OPENAI_API_KEY=

# --- Email (Resend free tier) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Comma-separated addresses that may see the inbound queue at /inbox
NOVERA_STAFF_EMAILS=

# Guards /api/support-agent, which exposes our own support agent so Novera can test it
NOVERA_SUPPORT_AGENT_TOKEN=
